{
  "name": "pi-sych",
  "version": "6.3.0-rc.0",
  "description": "General project and artifact development workbench for Pi",
  "files": [
    "templates",
    "docs",
    "extensions",
    "skills",
    "site",
    "tests/benchmarks",
    "scripts/benchmark.mjs",
    "scripts/bootstrap-worker-agent-dir.mjs",
    "scripts/check-mcporter-dependencies.mjs",
    "scripts/check-source-budget.mjs",
    "scripts/format-markdown.mjs",
    "scripts/generate-code-reference.mjs",
    "scripts/install-latest-pandoc.mjs",
    "scripts/site-links.mjs",
    "Makefile",
    "config.mk",
    "README.md",
    "AGENTS.md",
    "COPYING.md"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=26"
  },
  "repository": {
    "type": "git",
    "url": "git+https://gitlab.com/Joao-O-Santos/pi-sych.git"
  },
  "homepage": "https://gitlab.com/Joao-O-Santos/pi-sych#readme",
  "bugs": {
    "url": "https://gitlab.com/Joao-O-Santos/pi-sych/-/issues"
  },
  "type": "module",
  "keywords": [
    "pi-package",
    "pi",
    "agent",
    "writing",
    "research",
    "software-engineering"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint extensions scripts tests",
    "format:check": "biome ci --linter-enabled=false --assist-enabled=false extensions scripts tests",
    "format:fix": "biome check --write extensions scripts tests",
    "markdown:check": "node scripts/format-markdown.mjs",
    "markdown:fix": "node scripts/format-markdown.mjs --write",
    "site:build": "make",
    "style": "biome ci extensions scripts tests && npm run markdown:check",
    "source:budget": "node scripts/check-source-budget.mjs",
    "build:test": "rm -rf .test-build && tsc --project tsconfig.test.json",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "npm run build:test && node --test tests/unit/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:usage": "node --test tests/usage/*.test.mjs",
    "benchmark": "node scripts/benchmark.mjs",
    "test:coverage": "npm run build:test && node --experimental-test-coverage --test-coverage-include='.test-build/**/*.js' --test-coverage-lines=90 --test-coverage-branches=90 --test-coverage-functions=90 --test tests/unit/*.test.mjs tests/integration/*.test.mjs",
    "test:deps": "node scripts/check-mcporter-dependencies.mjs",
    "deps:latest": "npm update pi-mcporter && npm run test:deps && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "latest",
    "@earendil-works/pi-coding-agent": "latest",
    "@types/node": "latest",
    "typebox": "latest",
    "typescript": "latest"
  },
  "pi": {
    "extensions": [
      "./extensions/workbench/index.ts",
      "./extensions/plannotator/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "optionalDependencies": {
    "@plannotator/pi-extension": "latest",
    "jiti": "latest",
    "pi-mcporter": "latest"
  }
}
